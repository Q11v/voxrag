# Required
OPENROUTER_API_KEY=sk-or-...

# Optional — everything below is already the built-in default
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

QDRANT_HOST=localhost
QDRANT_PORT=6333

ASR_MODEL=mlx-community/whisper-turbo
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
LLM_MODEL=z-ai/glm-4.5-air:free

COLLECTION_NAME=voxrag
VECTOR_SIZE=1024

CHUNK_MAX_SIZE=400
CHUNK_OVERLAP_SEGS=2
RETRIEVE_TOP_K=20
RERANK_TOP_K=3

# point id 的 UUID 命名空间，用于把 (source, chunk 序号) 映射为稳定的 id
ID_NAMESPACE=00000000-0000-0000-0000-000000000001

# Set to 1 after models are downloaded to skip HF network checks
HF_HUB_OFFLINE=0
# Only needed for gated models — leave commented out otherwise
# HF_TOKEN=hf_xxx

# CLI defaults (optional)
VOXRAG_VERBOSE=0
VOXRAG_LOG_FILE=./log/main.log
